---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { useTranslations, switchLangPath } from "../i18n/utils";
import { defaultLang, type Lang } from "../i18n/ui";
import "../styles/global.css";

interface Props {
  title: string;
  lang: Lang;
  description?: string;
  /* true → Seite aus dem Index halten (Rechtstexte, Selbstbedienungsseiten) */
  noindex?: boolean;
  /* Pfad unter public/og/ – erzeugt von scripts/generate-og-images.mjs */
  ogImagePath?: string;
  /* Sprachen, in denen es diese Seite gibt. Landingpages liegen vorerst nur
     auf Deutsch vor – dann darf kein hreflang auf eine 404-URL zeigen. */
  availableLangs?: readonly Lang[];
}

const {
  title,
  lang,
  description,
  noindex = false,
  ogImagePath = "/og/default.png",
  availableLangs = ["de", "en"] as const,
} = Astro.props;
const t = useTranslations(lang);
const metaDescription = description ?? t("metaDefaultDesc");

// hreflang-Alternates – nur für Sprachen, in denen die Seite existiert
const dePath = switchLangPath(Astro.url, "de", availableLangs);
const enPath = switchLangPath(Astro.url, "en", availableLangs);

// Canonical: verhindert, dass Varianten (Query-Parameter, versehentliche
// Doppel-URLs) als eigenständige Seiten in den Index wandern.
const canonical = new URL(Astro.url.pathname, Astro.site);
// Englische Karten liegen unter demselben Namen mit "en-"-Präfix
const ogImage = new URL(
  lang === "de" ? ogImagePath : ogImagePath.replace("/og/", "/og/en-"),
  Astro.site,
);
const ogLocale = lang === "de" ? "de_DE" : "en_GB";
const ogLocaleAlt = lang === "de" ? "en_GB" : "de_DE";

/* Organisation site-weit: verknüpft Marke, Logo und Kontaktkanäle für die
   Knowledge-Graph-Auswertung. Nur einmal pro Seite ausgeben. */
const organizationLd = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "SentryMail",
  url: new URL("/", Astro.site).href,
  logo: new URL("/brand/logo-lockup-light-transparent.png", Astro.site).href,
  description: t("metaDefaultDesc"),
  areaServed: "EU",
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={metaDescription} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#FBFBFC" />
    {/* follow → Links werden weiterhin verfolgt, nur die Seite selbst nicht indexiert */}
    {noindex && <meta name="robots" content="noindex, follow" />}

    <!-- Favicons (SentryMail Design-System) -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

    <!-- Self-hosted Fonts vorladen (privacy-first, kein externer Request) -->
    <link
      rel="preload"
      href="/fonts/roboto.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/roboto-mono.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <link rel="canonical" href={canonical} />
    {
      availableLangs.includes("de") && (
        <link rel="alternate" hreflang="de" href={new URL(dePath, Astro.site)} />
      )
    }
    {
      availableLangs.includes("en") && (
        <link rel="alternate" hreflang="en" href={new URL(enPath, Astro.site)} />
      )
    }
    <link
      rel="alternate"
      hreflang="x-default"
      href={new URL(
        switchLangPath(Astro.url, defaultLang, availableLangs),
        Astro.site,
      )}
    />

    <!-- Open Graph / Twitter: steuert die Vorschaukarte in LinkedIn, Slack, X … -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="SentryMail" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="SentryMail – Security Awareness" />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:locale:alternate" content={ogLocaleAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={ogImage} />

    <title>{title}</title>

    <script
      type="application/ld+json"
      set:html={JSON.stringify(organizationLd)}
      is:inline
    />
    <!-- Seiten ergänzen hier eigenes JSON-LD (FAQPage, Product, …) -->
    <slot name="head" />
  </head>
  <body class="flex min-h-screen flex-col">
    <Header lang={lang} availableLangs={availableLangs} />
    <main class="flex-1">
      <slot />
    </main>
    <Footer lang={lang} />

    <!-- Minimales globales JS: nur Scroll-Reveal per IntersectionObserver -->
    <script>
      const els = document.querySelectorAll(".reveal");
      const io = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add("is-visible");
              io.unobserve(entry.target);
            }
          }
        },
        { threshold: 0.15 },
      );
      els.forEach((el) => io.observe(el));
    </script>
  </body>
</html>
